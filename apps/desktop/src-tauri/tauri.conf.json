{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentFlow",
  "version": "0.1.0",
  "identifier": "com.agentflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AgentFlow",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:1420 ws://127.0.0.1:1420 ipc:; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../../../apps/runtime/dist/**/*": "runtime/",
      "../../../apps/runtime/package.json": "runtime/package.json",
      "../../../node_modules/better-sqlite3/": "runtime/node_modules/better-sqlite3/",
      "../../../node_modules/bindings/": "runtime/node_modules/bindings/",
      "../../../node_modules/file-uri-to-path/": "runtime/node_modules/file-uri-to-path/"
    },
    "shortDescription": "Local-first multi-agent coding workflow"
  }
}
